enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model RegulatorySource {
  id                String           @id @default(uuid()) @db.Uuid
  framework         String           @db.VarChar(50)
  sourceName        String           @db.VarChar(255) @map("source_name")
  sourceUrl         String           @db.VarChar(500) @map("source_url")
  jurisdiction      String           @db.VarChar(50)
  monitorFrequency  MonitorFrequency @default(DAILY) @map("monitor_frequency")
  lastChecked       DateTime?        @map("last_checked")
  lastChanged       DateTime?        @map("last_changed")
  contentHash       String?          @db.VarChar(64) @map("content_hash")
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now()) @map("created_at")

  changeEvents      RegulatoryChangeEvent[]

  @@index([framework, active])
  @@map("regulatory_sources")
}

model RegulatoryChangeEvent {
  id              String            @id @default(uuid()) @db.Uuid
  sourceId        String            @db.Uuid @map("source_id")
  detectedAt      DateTime          @default(now()) @map("detected_at")
  changeSummary   String?           @db.Text @map("change_summary")
  previousHash    String?           @db.VarChar(64) @map("previous_hash")
  newHash         String            @db.VarChar(64) @map("new_hash")
  rawContent      String?           @db.Text @map("raw_content")
  aiAnalysis      Json?             @map("ai_analysis")
  status          ChangeEventStatus @default(DETECTED)
  createdAt       DateTime          @default(now()) @map("created_at")

  source          RegulatorySource  @relation(fields: [sourceId], references: [id])
  proposals       RegulatoryUpdateProposal[]

  @@index([sourceId, detectedAt])
  @@index([status])
  @@map("regulatory_change_events")
}

model RegulatoryUpdateProposal {
  id                  String            @id @default(uuid()) @db.Uuid
  changeEventId       String            @db.Uuid @map("change_event_id")
  ruleCode            String            @db.VarChar(20) @map("rule_code")
  framework           String            @db.VarChar(50)
  proposedChangeType  ProposalChangeType @map("proposed_change_type")
  currentRuleText     String?           @db.Text @map("current_rule_text")
  proposedRuleText    String            @db.Text @map("proposed_rule_text")
  changeRationale     String            @db.Text @map("change_rationale")
  severity            FindingSeverity
  effectiveDate       DateTime?         @db.Date @map("effective_date")
  status              ProposalStatus    @default(PENDING)
  reviewedBy          String?           @db.Uuid @map("reviewed_by")
  reviewedAt          DateTime?         @map("reviewed_at")
  rejectionReason     String?           @db.Text @map("rejection_reason")
  appliedAt           DateTime?         @map("applied_at")
  createdAt           DateTime          @default(now()) @map("created_at")

  changeEvent         RegulatoryChangeEvent @relation(fields: [changeEventId], references: [id])

  @@index([status])
  @@index([framework, ruleCode])
  @@map("regulatory_update_proposals")
}

// ─── DEEP INGESTION ──────────────────────────────────────────────────────────

enum IngestionDocStatus {
  PENDING
  FETCHING
  CHUNKING
  EXTRACTING
  VALIDATING
  COMPLETE
  FAILED
}

enum ValidationStatus {
  VERIFIED
  UPDATED
  CREATED
  UNVERIFIED
}

model IngestionDocument {
  id            String             @id @default(uuid()) @db.Uuid
  framework     String             @db.VarChar(50)
  sourceName    String             @db.VarChar(255) @map("source_name")
  sourceUrl     String             @db.VarChar(500) @map("source_url")
  rawContent    String?            @db.Text @map("raw_content")
  contentHash   String?            @db.VarChar(64) @map("content_hash")
  pageCount     Int?               @map("page_count")
  chunkCount    Int?               @map("chunk_count")
  ingestedAt    DateTime?          @map("ingested_at")
  status        IngestionDocStatus @default(PENDING)
  errorMessage  String?            @db.Text @map("error_message")
  createdAt     DateTime           @default(now()) @map("created_at")

  validationResults IngestionValidationResult[]

  @@index([framework, status])
  @@map("ingestion_documents")
}

model IngestionValidationResult {
  id                    String           @id @default(uuid()) @db.Uuid
  documentId            String           @db.Uuid @map("document_id")
  framework             String           @db.VarChar(50)
  ruleCode              String?          @db.VarChar(20) @map("rule_code")
  validationStatus      ValidationStatus @map("validation_status")
  sourceArticle         String?          @db.VarChar(255) @map("source_article")
  extractedObligation   String           @db.Text @map("extracted_obligation")
  confidenceScore       Int              @map("confidence_score")
  detail                String?          @db.Text
  adminReviewed         Boolean          @default(false) @map("admin_reviewed")
  createdAt             DateTime         @default(now()) @map("created_at")

  document              IngestionDocument @relation(fields: [documentId], references: [id])

  @@index([framework, validationStatus])
  @@index([documentId])
  @@map("ingestion_validation_results")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

enum BillingStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  FAILED
  VOID
}

model BillingInvoice {
  id                String        @id @default(uuid()) @db.Uuid
  firmId            String        @db.Uuid @map("firm_id")
  stripeInvoiceId   String?       @db.VarChar(255) @map("stripe_invoice_id")
  periodStart       DateTime      @db.Date @map("period_start")
  periodEnd         DateTime      @db.Date @map("period_end")
  monthEndBalance   Decimal       @default(0) @db.Decimal(18, 2) @map("month_end_balance")
  baseFee           Decimal       @db.Decimal(12, 2) @map("base_fee")
  basisPointsAmount Decimal       @db.Decimal(12, 2) @map("basis_points_amount")
  totalAmount       Decimal       @db.Decimal(12, 2) @map("total_amount")
  currency          String        @default("GBP") @db.Char(3)
  status            InvoiceStatus @default(DRAFT)
  createdAt         DateTime      @default(now()) @map("created_at")
  paidAt            DateTime?     @db.Timestamptz @map("paid_at")

  firm              Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, status])
  @@index([periodStart, periodEnd])
  @@map("billing_invoices")
}

model BillingSetting {
  id              String   @id @default(uuid()) @db.Uuid
  firmId          String   @db.Uuid @map("firm_id")
  baseMonthlyFee  Decimal  @db.Decimal(12, 2) @map("base_monthly_fee")
  basisPointsRate Decimal  @db.Decimal(12, 10) @map("basis_points_rate")
  trialDays       Int      @default(30) @map("trial_days")
  notes           String?  @db.Text
  updatedBy       String?  @db.Uuid @map("updated_by")
  updatedAt       DateTime @default(now()) @map("updated_at")

  firm            Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  updater         User?    @relation(fields: [updatedBy], references: [id])

  @@index([firmId])
  @@map("billing_settings")
}

// ─── AI Assistant ─────────────────────────────────────────────────────────────

model AiConversation {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String   @db.Uuid @map("firm_id")
  userId      String   @db.Uuid @map("user_id")
  sessionId   String   @db.VarChar(100) @map("session_id")
  role        String   @db.VarChar(20)
  content     String   @db.Text
  contextType String   @default("general") @db.VarChar(50) @map("context_type")
  tokensUsed  Int      @default(0) @map("tokens_used")
  createdAt   DateTime @default(now()) @map("created_at")

  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt(sort: Desc)])
  @@index([sessionId])
  @@index([userId])
  @@map("ai_conversations")
}

// ─── TASK 1: ASSET POOLS & RECONCILIATION CALENDAR ──────────────────────────

model AssetPool {
  id              String        @id @default(uuid()) @db.Uuid
  firmId          String        @db.Uuid @map("firm_id")
  name            String        @db.VarChar(255)
  poolType        AssetPoolType @map("pool_type")
  description     String?       @db.Text
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  firm            Firm          @relation(fields: [firmId], references: [id])
  reconciliationRuns ReconciliationRun[]

  @@unique([firmId, name])
  @@map("asset_pools")
}

model ReconciliationCalendarDay {
  id              String    @id @default(uuid()) @db.Uuid
  firmId          String?   @db.Uuid @map("firm_id")
  calendarDate    DateTime  @db.Date @map("calendar_date")
  isHoliday       Boolean   @default(false) @map("is_holiday")
  holidayName     String?   @db.VarChar(255) @map("holiday_name")
  calendarType    String    @db.VarChar(50) @map("calendar_type")
  country         String    @db.VarChar(10)
  createdAt       DateTime  @default(now()) @map("created_at")

  firm            Firm?     @relation(fields: [firmId], references: [id])

  @@unique([firmId, calendarDate, calendarType])
  @@index([calendarDate])
  @@map("reconciliation_calendar_days")
}

model BankStatementImport {
  id                    String                    @id @default(uuid()) @db.Uuid
  firmId                String                    @db.Uuid @map("firm_id")
  safeguardingAccountId String?                   @db.Uuid @map("safeguarding_account_id")
  format                BankStatementFormat
  filename              String                    @db.VarChar(255)
  fileStoragePath       String?                   @db.VarChar(500) @map("file_storage_path")
  statementDate         DateTime?                 @db.Date @map("statement_date")
  openingBalance        Decimal?                  @db.Decimal(18, 2) @map("opening_balance")
  closingBalance        Decimal?                  @db.Decimal(18, 2) @map("closing_balance")
  transactionCount      Int                       @default(0) @map("transaction_count")
  currency              String?                   @db.Char(3)
  bankReference         String?                   @db.VarChar(255) @map("bank_reference")
  rawData               Json?                     @map("raw_data")
  status                BankStatementImportStatus @default(PENDING)
  errorMessage          String?                   @db.Text @map("error_message")
  importedBy            String?                   @db.Uuid @map("imported_by")
  createdAt             DateTime                  @default(now()) @map("created_at")

  firm                  Firm                      @relation(fields: [firmId], references: [id])
  safeguardingAccount   SafeguardingAccount?      @relation(fields: [safeguardingAccountId], references: [id])

  @@index([firmId, statementDate])
  @@map("bank_statement_imports")
}

// ─── TASK 2: RESOLUTION PACK ────────────────────────────────────────────────

model ResolutionPack {
  id                String    @id @default(uuid()) @db.Uuid
  firmId            String    @db.Uuid @map("firm_id")
  version           Int       @default(1)
  generatedAt       DateTime  @default(now()) @map("generated_at")
  pdfStoragePath    String?   @db.VarChar(500) @map("pdf_storage_path")
  completenessScore Int       @default(0) @map("completeness_score")
  components        Json
  componentStatuses Json      @map("component_statuses")
  lastChangedAt     DateTime  @default(now()) @map("last_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  firm              Firm      @relation(fields: [firmId], references: [id])

  @@index([firmId, version])
  @@map("resolution_packs")
}

// ─── TASK 4: FCA MONTHLY RETURN ─────────────────────────────────────────────

model FcaMonthlyReturn {
  id                    String          @id @default(uuid()) @db.Uuid
  firmId                String          @db.Uuid @map("firm_id")
  reportingMonth        DateTime        @db.Date @map("reporting_month")
  submissionDeadline    DateTime        @db.Date @map("submission_deadline")
  status                FcaReturnStatus @default(DRAFT)
  // Section A - Firm details
  sectionA              Json            @map("section_a")
  // Section B - Relevant funds
  sectionB              Json            @map("section_b")
  // Section C - Safeguarding accounts
  sectionC              Json            @map("section_c")
  // Section D - Relevant assets
  sectionD              Json            @map("section_d")
  // Section E - Insurance/guarantee
  sectionE              Json?           @map("section_e")
  // Section F - Breaches
  sectionF              Json            @map("section_f")
  validationErrors      Json?           @map("validation_errors")
  pdfStoragePath        String?         @db.VarChar(500) @map("pdf_storage_path")
  exportDataPath        String?         @db.VarChar(500) @map("export_data_path")
  finalisedBy           String?         @db.Uuid @map("finalised_by")
  finalisedAt           DateTime?       @map("finalised_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  firm                  Firm            @relation(fields: [firmId], references: [id])

  @@unique([firmId, reportingMonth])
  @@index([firmId, status])
  @@map("fca_monthly_returns")
}

// ─── TASK 5: ADDITIONAL FCA FORMS ───────────────────────────────────────────

model FcaFormSubmission {
  id                String        @id @default(uuid()) @db.Uuid
  firmId            String        @db.Uuid @map("firm_id")
  formType          FcaFormType   @map("form_type")
  reportingPeriodStart DateTime  @db.Date @map("reporting_period_start")
  reportingPeriodEnd   DateTime  @db.Date @map("reporting_period_end")
  autoPopulatedData Json          @map("auto_populated_data")
  manualFields      Json?         @map("manual_fields")
  status            FcaReturnStatus @default(DRAFT)
  pdfStoragePath    String?       @db.VarChar(500) @map("pdf_storage_path")
  exportDataPath    String?       @db.VarChar(500) @map("export_data_path")
  notes             String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  firm              Firm          @relation(fields: [firmId], references: [id])

  @@index([firmId, formType])
  @@map("fca_form_submissions")
}

// ─── TASK 6: AUDIT EVIDENCE PACK ────────────────────────────────────────────

model AuditEvidencePack {
  id              String    @id @default(uuid()) @db.Uuid
  firmId          String    @db.Uuid @map("firm_id")
  periodStart     DateTime  @db.Date @map("period_start")
  periodEnd       DateTime  @db.Date @map("period_end")
  pdfStoragePath  String?   @db.VarChar(500) @map("pdf_storage_path")
  contentHash     String?   @db.VarChar(64) @map("content_hash")
  generatedBy     String    @db.Uuid @map("generated_by")
  reconDaysCount  Int       @default(0) @map("recon_days_count")
  breachCount     Int       @default(0) @map("breach_count")
  shortfallCount  Int       @default(0) @map("shortfall_count")
  resPackStatus   String?   @db.VarChar(20) @map("res_pack_status")
  createdAt       DateTime  @default(now()) @map("created_at")

  firm            Firm      @relation(fields: [firmId], references: [id])

  @@index([firmId, periodStart])
  @@map("audit_evidence_packs")
}

// ─── TASK 8: THIRD-PARTY REGISTER ───────────────────────────────────────────

model ThirdPartyRegister {
  id              String          @id @default(uuid()) @db.Uuid
  firmId          String          @db.Uuid @map("firm_id")
  name            String          @db.VarChar(255)
  partyType       ThirdPartyType  @map("party_type")
  jurisdiction    String?         @db.VarChar(100)
  dateAppointed   DateTime        @db.Date @map("date_appointed")
  servicesProvided String?        @db.Text @map("services_provided")
  contactName     String?         @db.VarChar(255) @map("contact_name")
  contactEmail    String?         @db.VarChar(255) @map("contact_email")
  contactPhone    String?         @db.VarChar(50) @map("contact_phone")
  isActive        Boolean         @default(true) @map("is_active")
  linkedSafeguardingAccountId String? @db.Uuid @map("linked_safeguarding_account_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  firm            Firm            @relation(fields: [firmId], references: [id])

  @@index([firmId, partyType])
  @@map("third_party_registers")
}

model DiversificationAssessment {
  id              String    @id @default(uuid()) @db.Uuid
  firmId          String    @db.Uuid @map("firm_id")
  assessmentDate  DateTime  @db.Date @map("assessment_date")
  isDiversified   Boolean   @map("is_diversified")
  rationale       String    @db.Text
  singleBankFlag  Boolean   @default(false) @map("single_bank_flag")
  assessedBy      String    @db.VarChar(255) @map("assessed_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  firm            Firm      @relation(fields: [firmId], references: [id])

  @@index([firmId, assessmentDate])
  @@map("diversification_assessments")
}

// ─── TASK 11: BANK API KEYS ─────────────────────────────────────────────────

model BankApiKey {
  id                String          @id @default(uuid()) @db.Uuid
  firmId            String?         @db.Uuid @map("firm_id")
  bankInstitutionId String          @db.Uuid @map("bank_institution_id")
  keyHash           String          @unique @db.VarChar(128) @map("key_hash")
  keyPrefix         String          @db.VarChar(10) @map("key_prefix")
  label             String          @db.VarChar(255)
  isActive          Boolean         @default(true) @map("is_active")
  lastUsedAt        DateTime?       @map("last_used_at")
  expiresAt         DateTime?       @map("expires_at")
  rateLimitPerMin   Int             @default(60) @map("rate_limit_per_min")
  createdAt         DateTime        @default(now()) @map("created_at")

  firm              Firm?           @relation(fields: [firmId], references: [id])

  @@index([bankInstitutionId])
  @@map("bank_api_keys")
}

// ─── TASK 12: SAFEGUARDING OBLIGATIONS ──────────────────────────────────────

model SafeguardingObligation {
  id                String                      @id @default(uuid()) @db.Uuid
  firmId            String                      @db.Uuid @map("firm_id")
  clientAccountId   String?                     @db.Uuid @map("client_account_id")
  transactionRef    String?                     @db.VarChar(255) @map("transaction_ref")
  amount            Decimal                     @db.Decimal(18, 2)
  currency          String                      @db.Char(3)
  fundsReceivedAt   DateTime                    @map("funds_received_at")
  safeguardingStartedAt DateTime?               @map("safeguarding_started_at")
  safeguardingEndedAt   DateTime?               @map("safeguarding_ended_at")
  endReason         String?                     @db.VarChar(100) @map("end_reason")
  fxType            FxTransactionType           @default(UNKNOWN) @map("fx_type")
  isUnclaimed       Boolean                     @default(false) @map("is_unclaimed")
  unclaimedSince    DateTime?                   @map("unclaimed_since")
  status            SafeguardingObligationStatus @default(ACTIVE)
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  firm              Firm                        @relation(fields: [firmId], references: [id])

  @@index([firmId, status])
  @@index([firmId, isUnclaimed])
  @@map("safeguarding_obligations")
}

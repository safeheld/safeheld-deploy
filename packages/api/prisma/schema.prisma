model FrameworkRule {
  id                String          @id @default(uuid()) @db.Uuid
  framework         String          @db.VarChar(50)
  ruleCode          String          @unique @db.VarChar(20) @map("rule_code")
  ruleName          String          @db.VarChar(255) @map("rule_name")
  ruleDescription   String          @db.Text @map("rule_description")
  severity          FindingSeverity
  active            Boolean         @default(true)
  version           Int             @default(1)
  effectiveFrom     DateTime        @db.Date @map("effective_from")
  effectiveTo       DateTime?       @db.Date @map("effective_to")
  sourceRegulation  String          @db.VarChar(255) @map("source_regulation")
  sourceArticle     String          @db.VarChar(255) @map("source_article")
  evaluationConfig  Json?           @map("evaluation_config")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  findings          ComplianceFinding[]

  @@index([framework, active])
  @@index([ruleCode])
  @@map("framework_rules")
}

